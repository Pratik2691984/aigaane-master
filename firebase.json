{
  "hosting": {
    "site": "aigaane-sanctuary",
    "public": "frontend/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "aigaane-engine",
          "region": "asia-south1"
        }
      }
    ]
  }
}
