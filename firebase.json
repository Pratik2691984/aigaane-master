{
  "hosting": {
    "site": "aigaane-sanctuary",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.bak-*",
      "**/*.py"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "aigaane-engine",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/**/*.@(js|css|mjs|wasm|db|json)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  }
}