{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigaane.in/schemas/router_policy.schema.json",
  "title": "Aigaane Router & CEGAR Critic Policy Schema",
  "type": "object",
  "required": ["canonical_prefix", "deprecated_prefix", "neural_fallback_policy", "critic_policy", "allowed_routes"],
  "additionalProperties": false,
  "properties": {
    "canonical_prefix": { "const": "/api/v3" },
    "deprecated_prefix": { "const": "/api/v1" },
    "neural_fallback_policy": {
      "type": "object",
      "required": ["max_confidence", "can_override_kernel", "renderer_input_scope"],
      "additionalProperties": false,
      "properties": {
        "max_confidence": { "type": "number", "maximum": 0.75 },
        "can_override_kernel": { "const": false },
        "renderer_input_scope": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "enum": ["verified_facts", "commentary_passages", "display_encodings"] },
          "uniqueItems": true
        }
      }
    },
    "critic_policy": {
      "type": "object",
      "required": ["deterministic_only", "require_nyaya_syllogism", "nyaya_steps"],
      "additionalProperties": false,
      "properties": {
        "deterministic_only": { "const": true },
        "require_nyaya_syllogism": { "const": true },
        "nyaya_steps": {
          "type": "array",
          "prefixItems": [
            { "const": "pratijna" },
            { "const": "hetu" },
            { "const": "udaharana" },
            { "const": "upanaya" },
            { "const": "nigamana" }
          ],
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "allowed_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^/(health|parse|route|sruti|sandhi|samasa|morphology|chandas|lexicon|corpus|studio3)"
      }
    }
  }
}