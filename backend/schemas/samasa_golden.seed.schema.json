{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigaane.in/schemas/samasa_golden.seed.schema.json",
  "title": "Aigaane Samasa Golden Corpus — Seed Schema",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9]+)?$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://aigaane.in/schemas/samasa_golden.schema.json#/$defs/golden_case" }
    }
  }
}