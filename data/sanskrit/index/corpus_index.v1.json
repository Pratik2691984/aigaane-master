    "sutra-0001": {
      "type": "sutra",
      "text": "वृद्धिरादै",
      "normalized": "वृदधिरादै"
    },
    "sutra-0002": {
      "type": "sutra",
      "text": "अदेङ् गुणः",
      "normalized": "अदेङ गुणः"
    },
    "sutra-0003": {
      "type": "sutra",
      "text": "हलन्त्यत्",
      "normalized": "हलनतयत"
    },
    "sutra-0004": {
      "type": "sutra",
      "text": "भूवादयो धातवः",
      "normalized": "भूवादयो धातवः"
    },
    "sutra-0005": {
      "type": "sutra",
      "text": "उपसर्गे धातुजम्",
      "normalized": "उपसरगे धातुजम"
    },
    "sutra-0006": {
      "type": "sutra",
      "text": "सुप्तिङन्तं धातुः",
      "normalized": "सुपतिङनतं धातुः"
    },
    "sutra-0007": {
      "type": "sutra",
      "text": "अर्धधातुकं शेषः",
      "normalized": "अरधधातुकं शेषः"
    },
    "sutra-0008": {
      "type": "sutra",
      "text": "आत्मनेपदेषु",
      "normalized": "आतमनेपदेषु"
    },
    "sutra-0009": {
      "type": "sutra",
      "text": "टित आत्मनेपदम्",
      "normalized": "टित आतमनेपदम"
    },
    "sutra-0010": {
      "type": "sutra",
      "text": "प्राग्दीर्घात् सम्प्रसारणात्",
      "normalized": "परागदीरघात समपरसारणात"
    },
    "sutra-0011": {
      "type": "sutra",
      "text": "एकः पूर्वपरयोः",
      "normalized": "एकः पूरवपरयोः"
    },
    "sutra-0012": {
      "type": "sutra",
      "text": "नो नः स्वरि",
      "normalized": "नो नः सवरि"
    },
    "sutra-0013": {
      "type": "sutra",
      "text": "एङः पदान्तादति",
      "normalized": "एङः पदानतादति"
    },
    "sutra-0014": {
      "type": "sutra",
      "text": "समासेऽनात्पौर्वपदात्",
      "normalized": "समासेऽनातपौरवपदात"
    },
    "sutra-0015": {
      "type": "sutra",
      "text": "तृजुग्लुभुह्रदादिभ्यो ङित्",
      "normalized": "तृजुगलुभुहरदादिभयो ङित"
    },
    "sutra-0016": {
      "type": "sutra",
      "text": "वाऽवसानस्य",
      "normalized": "वाऽवसानसय"
    },
    "sutra-0017": {
      "type": "sutra",
      "text": "स्तोः श्चुना श्चुः",
      "normalized": "सतोः शचुना शचुः"
    },
    "stotra-0001": {
      "type": "stotra",
      "text": "नमः शिवाय",
      "normalized": "नमः शिवाय"
    },
    "stotra-0002": {
      "type": "stotra",
      "text": "विष्णु सहस्रनाम",
      "normalized": "विषणु सहसरनाम"
    },
    "stotra-0003": {
      "type": "stotra",
      "text": "शान्तं शाश्वतमप्रमेयम्",
      "normalized": "शानतं शाशवतमपरमेयम"
    },
    "stotra-0004": {
      "type": "stotra",
      "text": "कराग्रे वसते लक्ष्मीः",
      "normalized": "करागरे वसते लकषमीः"
    },
    "stotra-0005": {
      "type": "stotra",
      "text": "सर्वं खल्विदं ब्रह्म",
      "normalized": "सरवं खलविदं बरहम"
    },
    "stotra-0006": {
      "type": "stotra",
      "text": "त्वमेव माता च पिता त्वमेव",
      "normalized": "तवमेव माता च पिता तवमेव"
    },
    "stotra-0007": {
      "type": "stotra",
      "text": "असतो मा सद्गमय",
      "normalized": "असतो मा सदगमय"
    },
    "stotra-0008": {
      "type": "stotra",
      "text": "तमसो मा ज्योतिर्गमय",
      "normalized": "तमसो मा जयोतिरगमय"
    },
    "stotra-0009": {
      "type": "stotra",
      "text": "मृत्योर्मा अमृतं गमय",
      "normalized": "मृतयोरमा अमृतं गमय"
    },
    "stotra-0010": {
      "type": "stotra",
      "text": "ॐ भूर्भुवः स्वः",
      "normalized": "ॐ भूरभुवः सवः"
    }
  },
