  "records": [
    {
      "record_id": "AIGAANE-BGM-04.002",
      "text": "एवं परम्पराप्राप्तमिमं राजर्षयो विदुः।",
      "iast": "evaṃ paramparāprāptamimaṃ rājarṣayo viduḥ।",
      "chapter": 4,
      "verse": 2,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.003",
      "text": "स एवायं मया तेऽद्य योगः प्रोक्तः पुरातनः।",
      "iast": "sa evāyaṃ mayā te'dya yogaḥ proktaḥ purātanaḥ।",
      "chapter": 4,
      "verse": 3,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.004",
      "text": "अपरं भवतो जन्म परं जन्म विवस्वतः।",
      "iast": "aparaṃ bhavato janma paraṃ janma vivasvataḥ।",
      "chapter": 4,
      "verse": 4,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.006",
      "text": "अजोऽपि सन्नव्ययात्मा भूतानामीश्वरोऽपि सन्।",
      "iast": "ajo'pi sannavyayātmā bhūtānāmīśvaro'pi san।",
      "chapter": 4,
      "verse": 6,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.007",
      "text": "यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।",
      "iast": "yadā yadā hi dharmasya glānirbhavati bhārata।",
      "chapter": 4,
      "verse": 7,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.008",
      "text": "परित्राणाय साधूनां विनाशाय च दुष्कृताम्।",
      "iast": "paritrāṇāya sādhūnāṃ vināśāya ca duṣkṛtām।",
      "chapter": 4,
      "verse": 8,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.009",
      "text": "जन्म कर्म च मे दिव्यमेवं यो वेत्ति तत्त्वतः।",
      "iast": "janma karma ca me divyamevaṃ yo vetti tattvataḥ।",
      "chapter": 4,
      "verse": 9,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.010",
      "text": "वीतरागभयक्रोधा मन्मया मामुपाश्रिताः।",
      "iast": "vītarāgabhayakrodhā manmayā māmupāśritāḥ।",
      "chapter": 4,
      "verse": 10,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.011",
      "text": "ये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम्।",
      "iast": "ye yathā māṃ prapadyante tāṃstathiva bhajāmyaham।",
      "chapter": 4,
      "verse": 11,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.012",
      "text": "काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः।",
      "iast": "kāṅkṣantaḥ karmaṇāṃ siddhiṃ yajanta iha devatāḥ।",
      "chapter": 4,
      "verse": 12,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.013",
      "text": "चातुर्वर्ण्यं मया सृष्टं गुणकर्मविभागशः।",
      "iast": "cāturvarṇyaṃ mayā sṛṣṭaṃ guṇakarmavibhāgaśaḥ।",
      "chapter": 4,
      "verse": 13,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.014",
      "text": "न मां कर्माणि लिम्पन्ति न मे कर्मफले स्पृहा।",
      "iast": "na māṃ karmāṇi limpanti na me karmaphale spṛhā।",
      "chapter": 4,
      "verse": 14,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.015",
      "text": "एवं ज्ञात्वा कृतं कर्म पूर्वैरपि मुमुक्षुभिः।",
      "iast": "evaṃ jñātvā kṛtaṃ karma pūrvirapi mumukṣubhiḥ।",
      "chapter": 4,
      "verse": 15,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.016",
      "text": "किं कर्म किमकर्मेति कवयोऽप्यत्र मोहिताः।",
      "iast": "kiṃ karma kimakarmeti kavayo'pyatra mohitāḥ।",
      "chapter": 4,
      "verse": 16,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.017",
      "text": "कर्मणो ह्यपि बोद्धव्यं बोद्धव्यं च विकर्मणः।",
      "iast": "karmaṇo hyapi boddhavyaṃ boddhavyaṃ ca vikarmaṇaḥ।",
      "chapter": 4,
      "verse": 17,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.018",
      "text": "कर्मण्यकर्म यः पश्येदकर्मणि च कर्म यः।",
      "iast": "karmaṇyakarma yaḥ paśyedakarmaṇi ca karma yaḥ।",
      "chapter": 4,
      "verse": 18,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.019",
      "text": "यस्य सर्वे समारम्भाः कामसङ्कल्पवर्जिताः।",
      "iast": "yasya sarve samārambhāḥ kāmasaṅkalpavarjitāḥ।",
      "chapter": 4,
      "verse": 19,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.020",
      "text": "त्यक्त्वा कर्मफलासङ्गं नित्यतृप्तो निराश्रयः।",
      "iast": "tyaktvā karmaphalāsaṅgaṃ nityatṛpto nirāśrayaḥ।",
      "chapter": 4,
      "verse": 20,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.021",
      "text": "निराशीर्यतचित्तात्मा त्यक्तसर्वपरिग्रहः।",
      "iast": "nirāśīryatacittātmā tyaktasarvaparigrahaḥ।",
      "chapter": 4,
      "verse": 21,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.022",
      "text": "यदृच्छालाभसन्तुष्टो द्वन्द्वातीतो विमत्सरः।",
      "iast": "yadṛcchālābhasantuṣṭo dvandvātīto vimatsaraḥ।",
      "chapter": 4,
      "verse": 22,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.023",
      "text": "गतसङ्गस्य मुक्तस्य ज्ञानावस्थितचेतसः।",
      "iast": "gatasaṅgasya muktasya jñānāvasthitacetasaḥ।",
      "chapter": 4,
      "verse": 23,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.024",
      "text": "ब्रह्मार्पणं ब्रह्महविर्ब्रह्माग्नौ ब्रह्मणा हुतम्।",
      "iast": "brahmārpaṇaṃ brahmahavirbrahmāgnu brahmaṇā hutam।",
      "chapter": 4,
      "verse": 24,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.025",
      "text": "दैवमेवापरे यज्ञं योगिनः पर्युपासते।",
      "iast": "divamevāpare yajñaṃ yoginaḥ paryupāsate।",
      "chapter": 4,
      "verse": 25,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.026",
      "text": "श्रोत्रादीनीन्द्रियाण्यन्ये संयमाग्निषु जुह्वति।",
      "iast": "śrotrādīnīndriyāṇyanye saṃyamāgniṣu juhvati।",
      "chapter": 4,
      "verse": 26,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.027",
      "text": "सर्वाणीन्द्रियकर्माणि प्राणकर्माणि चापरे।",
      "iast": "sarvāṇīndriyakarmāṇi prāṇakarmāṇi cāpare।",
      "chapter": 4,
      "verse": 27,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.028",
      "text": "द्रव्ययज्ञास्तपोयज्ञा योगयज्ञास्तथापरे।",
      "iast": "dravyayajñāstapoyajñā yogayajñāstathāpare।",
      "chapter": 4,
      "verse": 28,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.029",
      "text": "अपाने जुह्वति प्राण प्राणेऽपानं तथाऽपरे।",
      "iast": "apāne juhvati prāṇa prāṇe'pānaṃ tathā'pare।",
      "chapter": 4,
      "verse": 29,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.030",
      "text": "अपरे नियताहाराः प्राणान्प्राणेषु जुह्वति।",
      "iast": "apare niyatāhārāḥ prāṇānprāṇeṣu juhvati।",
      "chapter": 4,
      "verse": 30,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.031",
      "text": "यज्ञशिष्टामृतभुजो यान्ति ब्रह्म सनातनम्।",
      "iast": "yajñaśiṣṭāmṛtabhujo yānti brahma sanātanam।",
      "chapter": 4,
      "verse": 31,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.032",
      "text": "एवं बहुविधा यज्ञा वितता ब्रह्मणो मुखे।",
      "iast": "evaṃ bahuvidhā yajñā vitatā brahmaṇo mukhe।",
      "chapter": 4,
      "verse": 32,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.033",
      "text": "श्रेयान्द्रव्यमयाद्यज्ञाज्ज्ञानयज्ञः परन्तप।",
      "iast": "śreyāndravyamayādyajñājjñānayajñaḥ parantapa।",
      "chapter": 4,
      "verse": 33,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.034",
      "text": "तद्विद्धि प्रणिपातेन परिप्रश्नेन सेवया।",
      "iast": "tadviddhi praṇipātena paripraśnena sevayā।",
      "chapter": 4,
      "verse": 34,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.035",
      "text": "यज्ज्ञात्वा न पुनर्मोहमेवं यास्यसि पाण्डव।",
      "iast": "yajjñātvā na punarmohamevaṃ yāsyasi pāṇḍava।",
      "chapter": 4,
      "verse": 35,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.036",
      "text": "अपि चेदसि पापेभ्यः सर्वेभ्यः पापकृत्तमः।",
      "iast": "api cedasi pāpebhyaḥ sarvebhyaḥ pāpakṛttamaḥ।",
      "chapter": 4,
      "verse": 36,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.037",
      "text": "यथैधांसि समिद्धोऽग्निर्भस्मसात्कुरुतेऽर्जुन।",
      "iast": "yathidhāṃsi samiddho'gnirbhasmasātkurute'rjuna।",
      "chapter": 4,
      "verse": 37,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.038",
      "text": "न हि ज्ञानेन सदृशं पवित्रमिह विद्यते।",
      "iast": "na hi jñānena sadṛśaṃ pavitramiha vidyate।",
      "chapter": 4,
      "verse": 38,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.039",
      "text": "श्रद्धावाँल्लभते ज्ञानं तत्परः संयतेन्द्रियः।",
      "iast": "śraddhāvām̐llabhate jñānaṃ tatparaḥ saṃyatendriyaḥ।",
      "chapter": 4,
      "verse": 39,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.040",
      "text": "अज्ञश्चाश्रद्दधानश्च संशयात्मा विनश्यति।",
      "iast": "ajñaścāśraddadhānaśca saṃśayātmā vinaśyati।",
      "chapter": 4,
      "verse": 40,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.041",
      "text": "योगसंन्यस्तकर्माणं ज्ञानसंछिन्नसंशयम्।",
      "iast": "yogasaṃnyastakarmāṇaṃ jñānasaṃchinnasaṃśayam।",
      "chapter": 4,
      "verse": 41,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    },
    {
      "record_id": "AIGAANE-BGM-04.042",
      "text": "तस्मादज्ञानसंभूतं हृत्स्थं ज्ञानासिनाऽऽत्मनः।",
      "iast": "tasmādajñānasaṃbhūtaṃ hṛtsthaṃ jñānāsinā''tmanaḥ।",
      "chapter": 4,
      "verse": 42,
      "meter": "Anuṣṭubh",
      "source": "DharmicData/SrimadBhagvadGita"
    }
  ]
}